{
  "name": "che-board",
  "version": "0.1.9",
  "description": "Desktop console for the chi CLI — Electron + Angular GUI, modeled on chi's ux-console prototype.",
  "private": true,
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/chevp/che-board",
  "repository": {
    "type": "git",
    "url": "https://github.com/chevp/che-board.git"
  },
  "license": "Apache-2.0",
  "author": "chevp",
  "scripts": {
    "build:renderer": "ng build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:electron",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac --publish=never",
    "package:win": "electron-builder --win --publish=never",
    "start": "node scripts/launch.mjs",
    "dev:renderer": "ng serve --port 4200",
    "dev:electron": "tsc -p electron/tsconfig.json --watch",
    "dev": "concurrently -k -n ng,tsc,electron -c blue,magenta,cyan \"npm:dev:renderer\" \"npm:dev:electron\" \"node scripts/wait-and-launch.mjs\"",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit && ng build --configuration=development --output-path=.tmp-typecheck && rm -rf .tmp-typecheck"
  },
  "dependencies": {
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "chi": "github:chevp/chi",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.0",
    "zone.js": "^0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.10",
    "@angular/cli": "^21.2.10",
    "@angular/compiler-cli": "^21.0.0",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.chevp.cheboard",
    "productName": "che-board",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
