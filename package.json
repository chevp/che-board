{
  "name": "che-board",
  "version": "0.1.11",
  "description": "Desktop wrapper for the chi CLI's served web console.",
  "private": true,
  "main": "dist-electron/main.js",
  "homepage": "https://github.com/chevp/che-board",
  "repository": {
    "type": "git",
    "url": "https://github.com/chevp/che-board.git"
  },
  "license": "Apache-2.0",
  "author": "chevp",
  "scripts": {
    "build": "tsc -p electron/tsconfig.json",
    "package": "electron-builder",
    "package:mac": "electron-builder --mac --publish=never",
    "package:win": "electron-builder --win --publish=never",
    "start": "node scripts/launch.mjs",
    "dev:electron": "tsc -p electron/tsconfig.json --watch",
    "dev": "concurrently -k -n tsc,electron -c magenta,cyan \"npm:dev:electron\" \"node scripts/launch.mjs\"",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit"
  },
  "dependencies": {
    "chi": "github:chevp/chi"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "typescript": "~5.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "com.chevp.cheboard",
    "productName": "che-board",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chevp",
        "repo": "che-board"
      }
    ]
  }
}
